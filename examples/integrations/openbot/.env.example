# Required: create an OpenBot webhook routine and copy its URL and one-time secret.
OPENBOT_WEBHOOK_URL=https://example.openbot.run/replace-me
OPENBOT_WEBHOOK_SECRET=whsec_replace_me

# Generate independent local secrets, for example with: openssl rand -hex 32
OPENBOT_RELAY_TOKEN=replace_with_a_random_local_token
KAPTANTO_MCP_API_KEY=replace_with_another_random_token

# Comma-separated allowlist; arbitrary task types are rejected.
OPENBOT_ALLOWED_TASK_TYPES=payment_failure_triage
